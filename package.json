{
  "name": "pagir2",
  "private": true,
  "workspaces": [
    "backend",
    "mobile"
  ],
  "scripts": {
    "backend:dev": "npm --workspace=backend run dev",
    "backend:build": "npm --workspace=backend run build",
    "backend:start": "npm --workspace=backend run start",
    "mobile:android": "npm --workspace=mobile run android",
    "mobile:ios": "npm --workspace=mobile run ios",
    "db:generate": "npm --workspace=backend run db:generate",
    "db:migrate": "npm --workspace=backend run db:migrate"
  },
  "overrides": {
    "react-native-screens": "3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-vision-camera": "3.9.0"
  },
  "dependencies": {
    "react-native-screens": "3.29.0",
    "react-native-svg": "14.1.0"
  },
  "devDependencies": {
    "canvas": "^3.2.3"
  }
}
